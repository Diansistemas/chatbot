# Copia este fichero como .env y rellena los valores
#   cp .env.example .env
#
# Variables que LEE config/settings.py hoy:
#   SECRET_KEY, DEBUG, OLLAMA_HOST, OLLAMA_MODEL_RESUMEN,
#   DOMINIOS_PERMITIDOS, EMAIL_*, RESUMEN_EMAIL_DESTINATARIOS
#
# PENDIENTE de arreglar en settings.py (están en el informe de revisión):
#   ALLOWED_HOSTS y CSRF_TRUSTED_ORIGINS todavía están hardcodeados en
#   settings.py, así que ponerlos aquí no hace nada. Se documentan ya para
#   cuando se conecten.

# --- Django ---
# Clave secreta de Django. Obligatoria. Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambia-esta-clave-por-una-generada

# DEBUG: solo "True" activa el debug. Cualquier otra cosa (incluido "False")
# se compara como texto, ojo con esto.
DEBUG=True

# --- Hosts (por ahora sin efecto, ver nota superior) ---
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Widget ---
# Dominios que pueden embeber el widget. Formato OBLIGATORIO: esquema + dominio
# (el mixin hace urlparse y compara scheme y netloc; sin esquema => 403 en todo)
# Ejemplo: https://diansistemas.com,https://www.diansistemas.com
# Si dejas "http://localhost:8000" se generan tambien los modelos
# chatbot-localhost-{compra,consulta,otro}.
DOMINIOS_PERMITIDOS=http://localhost:8000

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_RESUMEN=llama3.2

# --- Email (resumenes de conversaciones) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
# Destinatarios de los resumenes, separados por coma
RESUMEN_EMAIL_DESTINATARIOS=
