# Plantilla de ejemplo del .env
#
# Lo mejor: no edites este fichero a mano, usa el asistente, que va pidiendo
# los datos y escribe el .env por ti:
#     python configurar_entorno.py               # interactivo
#     python configurar_entorno.py --defaults    # valores por defecto sin preguntar
#
# Este .env lo leen dos cosas:
#   * docker-compose.yml -> env_file (variables del contenedor) y
#     ${WEB_PORT}, ${OLLAMA_MODEL_RESUMEN}, ${SPACY_MODEL_HOST_PATH} (interpolacion)
#   * config/settings.py -> python-dotenv (carga las mismas variables)

# --- Django ---
# Clave secreta de Django. Obligatoria. El asistente la genera sola.
SECRET_KEY=cambia-esta-clave-por-una-generada

# DEBUG: solo "True" activa el debug (settings.py lo convierte a booleano).
DEBUG=True

# --- Hosts ---
# Hosts que puede servir Django, sin esquema, separados por coma.
# settings.py SIEMPRE admite testserver/localhost/127.0.0.1 y añade estos.
ALLOWED_HOSTS=localhost,127.0.0.1
# Origenes admitidos en peticiones cross-origin (con esquema).
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Widget ---
# Dominios que pueden embeber el widget. Formato OBLIGATORIO: esquema + dominio
# (el mixin hace urlparse y compara scheme y netloc; sin esquema => 403 en todo)
# Ejemplo: https://diansistemas.com,https://www.diansistemas.com
# Si dejas "http://localhost:8000" se generan tambien los modelos
# chatbot-localhost-{compra,consulta,otro}.
DOMINIOS_PERMITIDOS=http://localhost:8000

# --- Puerto del servidor web (lo usa docker-compose) ---
WEB_PORT=8000

# --- Ollama ---
# En local: localhost. En Docker compose lo sustituye por http://ollama:11434.
OLLAMA_HOST=http://localhost:11434
# Modelo que se usa para resumenes y que ollama-init baja en el primer arranque.
OLLAMA_MODEL_RESUMEN=llama3.2

# --- Email (resumenes de conversaciones) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
# Destinatarios de los resumenes, separados por coma
RESUMEN_EMAIL_DESTINATARIOS=

# --- Modelo spaCy (solo Docker) ---
# Ruta en el host a un modelo ya entrenado que se monta en el contenedor
# (vacio = se entrena dentro del contenedor y vive en el volumen spacy_model).
SPACY_MODEL_HOST_PATH=
# 1 = reentrenar el modelo NLP en el primer arranque (setup.sh / FORCE_TRAIN).
FORCE_TRAIN=0
